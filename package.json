{
  "name": "derrick-slack-bot",
  "version": "1.0.0",
  "description": "A Slack bot for interacting with OpenClaw AI agents",
  "main": "src/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "prestart": "npm run build",
    "rebuild": "rimraf dist && tsc"
  },
  "dependencies": {
    "@slack/bolt": "^3.13.0",
    "dotenv": "^16.4.5",
    "axios": "^1.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "rimraf": "^5.0.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}